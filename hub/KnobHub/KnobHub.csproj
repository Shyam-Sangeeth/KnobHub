<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004+ for the media session API (Windows.Media.Control) used by the Media app. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>KnobHub</AssemblyName>
    <RootNamespace>KnobHub</RootNamespace>
    <Version>1.0.1</Version>
    <Product>Knob Hub</Product>
    <Company>Shyam Sangeeth</Company>
    <!-- WPF Fluent theme (ThemeMode) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ApplicationIcon>Assets\KnobHub.ico</ApplicationIcon>
    <!-- The preview is a native x64 DLL. -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- Where Knob OS builds knob_preview.dll (pio run -e preview in knob-os; see the KnobPreview target). -->
    <KnobPreviewDll>$(USERPROFILE)\.cache\knob-os\build\preview\knob_preview.dll</KnobPreviewDll>
    <!-- Where Knob OS's real-knob builds leave their images (knob-os/scripts/merged.py; see the KnobFirmware target). -->
    <KnobFirmwareDir>$(USERPROFILE)\.cache\knob-os\firmware</KnobFirmwareDir>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\KnobHub.ico" />
  </ItemGroup>

  <!-- The live preview runs Knob OS from knob_preview.dll. PlatformIO clears its build folder whenever
       platformio.ini changes, so build the DLL here if it's missing, then copy it next to Knob Hub. -->
  <Target Name="KnobPreview" AfterTargets="Build">
    <!-- PlatformIO's native builds use the MinGW compiler in %USERPROFILE%\.mingw64. -->
    <Exec Condition="!Exists('$(KnobPreviewDll)')"
          Command="set &quot;PATH=$(USERPROFILE)\.mingw64\bin;%PATH%&quot; &amp;&amp; &quot;$(USERPROFILE)\.platformio\penv\Scripts\pio.exe&quot; run -e preview"
          WorkingDirectory="$(MSBuildProjectDirectory)\..\..\knob-os" />
    <Copy SourceFiles="$(KnobPreviewDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- The Knob OS images Knob Hub installs on knobs (Settings > Knob OS), from the last real-knob builds
       (pio run -e crowpanel-128 -e crowpanel-146 in knob-os), into a firmware folder. Without them Knob Hub still
       runs; it just has no Knob OS to install. -->
  <Target Name="KnobFirmware" AfterTargets="Build">
    <ItemGroup>
      <KnobFirmwareFile Include="$(KnobFirmwareDir)\*" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)firmware" />
    <Copy SourceFiles="@(KnobFirmwareFile)" DestinationFolder="$(OutDir)firmware" />
  </Target>

  <!-- dotnet publish (the installer's payload) takes the preview and the Knob OS images too. -->
  <Target Name="KnobPublishExtras" AfterTargets="Publish">
    <ItemGroup>
      <KnobFirmwareFile Include="$(KnobFirmwareDir)\*" />
    </ItemGroup>
    <Copy SourceFiles="$(KnobPreviewDll)" DestinationFolder="$(PublishDir)" />
    <RemoveDir Directories="$(PublishDir)firmware" />
    <Copy SourceFiles="@(KnobFirmwareFile)" DestinationFolder="$(PublishDir)firmware" />
  </Target>

  <ItemGroup>
    <!-- Keep WinForms types out of the global usings so they don't clash with WPF names. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KnobHub.Sdk\KnobHub.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.14" />
  </ItemGroup>

</Project>
