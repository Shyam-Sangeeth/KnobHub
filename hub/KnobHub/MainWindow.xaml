<Window x:Class="KnobHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Knob Hub"
        Icon="Assets/KnobHub.ico"
        Width="1100" Height="820" MinWidth="760" MinHeight="560"
        WindowStartupLocation="Manual" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">

    <!-- Knob Hub draws its own title bar (below); Windows still moves, resizes and snaps the window. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- The title bar's minimise / maximise / close buttons, like Windows' own. -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B3271C" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Margin while maximized, set in code: a maximized window reaches past the screen's edges by its frame. -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The title bar: logo and name on the left, the window's buttons on the right; drag it to move the window,
             double-click it to maximize. -->
        <DockPanel Background="{DynamicResource LayerFillColorDefaultBrush}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize" Click="Minimize_Click"
                        AutomationProperties.Name="Minimize" />
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximize"
                        Click="Maximize_Click" AutomationProperties.Name="Maximize" />
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Close" Click="Close_Click"
                        AutomationProperties.Name="Close" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Border Width="20" Height="20" CornerRadius="6" Background="#8B7CF6">
                        <Grid>
                            <Ellipse Width="11" Height="11" Margin="0,2,0,0" Stroke="White" StrokeThickness="2" />
                            <Rectangle Width="2" Height="4.5" Fill="White" VerticalAlignment="Top" Margin="0,3.5,0,0" RadiusX="1" RadiusY="1" />
                        </Grid>
                    </Border>
                <TextBlock Text="Knob Hub" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border BorderThickness="0,0,1,0" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel Margin="12,12,12,20">
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding HubVersion}" FontSize="12" Margin="14,12,0,0"
                           Style="{StaticResource SecondaryText}" />
                <ListBox x:Name="Nav" SelectedIndex="0" Background="Transparent" BorderThickness="0"
                         SelectionChanged="Nav_SelectionChanged">
                    <ListBoxItem Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B5;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="Knob" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF0E2;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="Apps" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE772;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="Board" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="Settings" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Knob: the live preview -->
        <ScrollViewer x:Name="KnobPage" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <!-- At least the page's height, so the preview's card fills it and the preview sits in its middle; a short
                 window scrolls instead. -->
            <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <Grid Margin="32,28,32,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel>
                    <TextBlock Text="{Binding KnobName}" Style="{StaticResource PageTitle}" Margin="0,0,16,4" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Chip}" VerticalAlignment="Center" Margin="0,0,16,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Status}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Details}" FontSize="13" VerticalAlignment="Center" Margin="0,0,0,4"
                               Style="{StaticResource SecondaryText}" />
                </WrapPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,22,0,0" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                         Fill="{DynamicResource SystemFillColorCriticalBrush}" />
                                <TextBlock Text="{Binding PreviewMode}" FontSize="12" Margin="6,0,0,0" Style="{StaticResource SecondaryText}" />
                            </StackPanel>
                            <TextBlock Text="Live preview" Style="{StaticResource SectionTitle}" />
                        </DockPanel>

                        <!-- The knob's round screen, 480 screen pixels across (sized in code for the monitor's
                             scaling), in a thin circle that flashes when the knob would vibrate, with its LEDs glowing
                             round it. Scroll = turn, middle-click = press (held: back, the knob's long press), left
                             button = touch (tap, drag, swipe). Only what the knob itself has. -->
                        <Grid x:Name="PreviewFrame" Grid.Row="1" Margin="0,30" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Background="Transparent" Cursor="Hand"
                              UseLayoutRounding="True" SnapsToDevicePixels="True"
                              MouseWheel="Preview_MouseWheel" MouseDown="Preview_MouseDown" MouseUp="Preview_MouseUp"
                              MouseLeftButtonDown="Preview_TouchDown" MouseMove="Preview_TouchMove"
                              MouseLeftButtonUp="Preview_TouchUp">
                            <!-- The LEDs, drawn in code behind the screen so only their glow outside it shows; the
                                 blur softens the joins between LEDs. -->
                            <Canvas x:Name="PreviewGlow" IsHitTestVisible="False">
                                <Canvas.Effect>
                                    <BlurEffect Radius="10" />
                                </Canvas.Effect>
                            </Canvas>
                            <!-- One pixel per screen pixel; nearest neighbour so nothing smears if the layout rounds. -->
                            <Image x:Name="PreviewScreen" Source="{Binding Screen}" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <Ellipse x:Name="PreviewDim" Fill="Black" Opacity="{Binding DimOpacity}" IsHitTestVisible="False" />
                            <Ellipse x:Name="PreviewRing" Stroke="#D9F2F3F5" StrokeThickness="2" IsHitTestVisible="False" />
                        </Grid>

                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="{Binding HapticsText}" FontSize="12" HorizontalAlignment="Center"
                                       Style="{StaticResource SecondaryText}"
                                       Visibility="{Binding ShowsHaptics, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding PreviewError}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,8,0,0"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        </StackPanel>

                        <!-- The controls, one chip per knob action: the action, then the mouse controls that do it. -->
                        <WrapPanel Grid.Row="3" HorizontalAlignment="Center">
                            <WrapPanel.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                                <Style x:Key="ChipAction" TargetType="Run">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                                <Style x:Key="ChipHow" TargetType="Run">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Style>
                            </WrapPanel.Resources>
                            <Border Style="{StaticResource Chip}" Margin="4">
                                <TextBlock><Run Text="Turn" Style="{StaticResource ChipAction}" /><Run Text="   Scroll" Style="{StaticResource ChipHow}" /></TextBlock>
                            </Border>
                            <Border Style="{StaticResource Chip}" Margin="4">
                                <TextBlock><Run Text="Press" Style="{StaticResource ChipAction}" /><Run Text="   Middle-click" Style="{StaticResource ChipHow}" /></TextBlock>
                            </Border>
                            <Border Style="{StaticResource Chip}" Margin="4">
                                <TextBlock><Run Text="Touch" Style="{StaticResource ChipAction}" /><Run Text="   Click or drag" Style="{StaticResource ChipHow}" /></TextBlock>
                            </Border>
                            <Border Style="{StaticResource Chip}" Margin="4">
                                <TextBlock><Run Text="Back" Style="{StaticResource ChipAction}" /><Run Text="   Hold middle-click or swipe right" Style="{StaticResource ChipHow}" /></TextBlock>
                            </Border>
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Apps -->
        <ScrollViewer x:Name="AppsPage" Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="32,28,32,32">
                <DockPanel>
                    <Button DockPanel.Dock="Right" VerticalAlignment="Center" Padding="14,7" Click="AddApps_Click" AutomationProperties.Name="Add apps"
                            Style="{DynamicResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="Add apps" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="Apps" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Drag apps to change their order on the knob's Home ring. Home starts on the first one."
                                   Margin="0,4,0,0" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Apps}" Margin="0,20,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- A row: drag it (anywhere but its controls) to move the app. While another row is dragged
                                 over it, a line above or below shows where that one will go. -->
                            <Grid Margin="0,0,0,8">
                                <Border Padding="8,12,16,12" AllowDrop="True"
                                        PreviewMouseLeftButtonDown="AppRow_MouseDown" PreviewMouseMove="AppRow_MouseMove"
                                        DragOver="AppRow_DragOver" Drop="AppRow_Drop">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDragged}" Value="True">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE76F;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,8,0"
                                               VerticalAlignment="Center" Cursor="SizeAll" ToolTip="Drag to move"
                                               Style="{StaticResource SecondaryText}" />
                                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20" Background="{Binding AccentFill}" VerticalAlignment="Center">
                                        <Grid>
                                            <!-- The icon as the knob shows it; a generic glyph for a name Knob Hub doesn't know. -->
                                            <Image Source="{Binding IconImage}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="17"
                                                       Foreground="{Binding Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding ShowGlyph, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="2" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                            <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock Text="{Binding SourceLabel}" FontSize="11" Style="{StaticResource SecondaryText}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource SecondaryText}" />
                                        <TextBlock Text="{Binding Details}" FontSize="12" Margin="0,2,0,0" Style="{StaticResource SecondaryText}" />
                                        <TextBlock Text="{Binding ErrorText}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- The app's own settings: a label and a drop-down each. -->
                                        <ItemsControl ItemsSource="{Binding Settings}" VerticalAlignment="Center" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                                        <TextBlock Text="{Binding Label}" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                   Style="{StaticResource SecondaryText}" />
                                                        <ComboBox MinWidth="80" VerticalAlignment="Center" ToolTip="{Binding Label}"
                                                                  ItemsSource="{Binding Options}" SelectedIndex="{Binding Selected}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="&#xE74D;" ToolTip="Uninstall" Style="{StaticResource IconButton}" Click="Uninstall_Click"
                                                Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVisibility}}" />
                                        <CheckBox IsChecked="{Binding Enabled}" Content="On the knob" Margin="16,0,0,0" VerticalAlignment="Center"
                                                  Visibility="{Binding CanTurnOff, Converter={StaticResource BoolToVisibility}}" />
                                        <!-- Clock: 24-hour or 12-hour (a knob setting, kept on the window's model). -->
                                        <ComboBox Width="130" VerticalAlignment="Center" ToolTip="Clock format"
                                                  ItemsSource="{Binding DataContext.ClockFormats, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedIndex="{Binding DataContext.ClockFormat, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Visibility="{Binding IsClock, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                                </Border>
                                <!-- Where a dragged row will go: above (1) or below (2) this one, in the gap between rows. -->
                                <Rectangle Height="2" RadiusX="1" RadiusY="1" VerticalAlignment="Top" Margin="8,-5,8,0"
                                           Fill="{DynamicResource AccentFillColorDefaultBrush}" IsHitTestVisible="False">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Visibility" Value="Hidden" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DropMark}" Value="1">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Height="2" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" Margin="8,0,8,-5"
                                           Fill="{DynamicResource AccentFillColorDefaultBrush}" IsHitTestVisible="False">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Visibility" Value="Hidden" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DropMark}" Value="2">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16">
                    <DockPanel>
                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,1,12,0"
                                   VerticalAlignment="Top" Style="{StaticResource SecondaryText}" />
                        <StackPanel>
                            <TextBlock Text="Apps run on your PC" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Margin="0,2,0,0" Style="{StaticResource SecondaryText}"
                                       Text="Plugins run with Knob Hub's permissions. Only install apps you trust. Knob Hub asks before installing anything." />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Board: which knob this is, what it has, and the settings only some knobs have. The preview is always the
             board of the last knob that connected. -->
        <ScrollViewer x:Name="BoardPage" Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="32,28,32,32" MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock Text="Board" Style="{StaticResource PageTitle}" />

                <TextBlock Text="This knob" Style="{StaticResource SectionTitle}" Margin="0,22,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding Board.Name}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding BoardDetails}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding BoardSource}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </Border>

                <!-- Only for knobs with LEDs. -->
                <StackPanel Visibility="{Binding HasLeds, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Lights" Style="{StaticResource SectionTitle}" Margin="0,22,0,8" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="180" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44" />
                                <RowDefinition Height="44" />
                                <RowDefinition Height="44" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="LED brightness" VerticalAlignment="Center" />
                            <DockPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" Text="{Binding LedBrightness, StringFormat={}{0}%}" />
                                <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding LedBrightness}" />
                            </DockPanel>

                            <TextBlock Grid.Row="1" Text="LED mode" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding LedModes}" SelectedIndex="{Binding LedMode}" />

                            <TextBlock Grid.Row="2" Text="LEDs off when dimmed" VerticalAlignment="Center" Margin="0,0,12,0"
                                       ToolTip="They're always off while the screen is off." />
                            <CheckBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding LedsIdleOff}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Only for knobs with a vibration motor or a motor on the knob. -->
                <StackPanel Visibility="{Binding HasHaptics, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Haptics" Style="{StaticResource SectionTitle}" Margin="0,22,0,8" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="180" />
                                    <ColumnDefinition Width="300" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Strength" />
                                    <TextBlock Text="How firm the knob's clicks and end stops are, and how strong the vibration is"
                                               FontSize="12" TextWrapping="Wrap" Style="{StaticResource SecondaryText}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding HapticStrengths}" SelectedIndex="{Binding Haptics}" />
                            </Grid>
                            <Grid MinHeight="44" Visibility="{Binding HasVibration, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="180" />
                                    <ColumnDefinition Width="300" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Vibration" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Vibration}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Text="This knob has no LEDs or haptics, so there's nothing else to set here." Margin="0,22,0,0"
                           Style="{StaticResource SecondaryText}"
                           Visibility="{Binding HasNoBoardSettings, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Settings -->
        <ScrollViewer x:Name="SettingsPage" Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="32,28,32,32" MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />

                <TextBlock Text="Knob" Style="{StaticResource SectionTitle}" Margin="0,22,0,8" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="44" />
                            <RowDefinition Height="44" />
                            <RowDefinition Height="44" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Screen brightness" VerticalAlignment="Center" />
                        <DockPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" Text="{Binding Brightness, StringFormat={}{0}%}" />
                            <Slider Minimum="5" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Brightness}" />
                        </DockPanel>

                        <TextBlock Grid.Row="1" Text="Screen timeout" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding Timeouts}" SelectedIndex="{Binding Timeout}" />

                        <TextBlock Grid.Row="2" Text="Dim the screen when idle" VerticalAlignment="Center" />
                        <CheckBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding DimIdle}" />

                        <TextBlock Grid.Row="3" Text="Name" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" MaxLength="24"
                                 Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                </Border>

                <TextBlock Text="Connection" Style="{StaticResource SectionTitle}" Margin="0,22,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding ConnectionText}" TextWrapping="Wrap" />
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,12" Style="{StaticResource SecondaryText}"
                                   Text="USB is used whenever it's plugged in. Wi-Fi setup (pairing mode, knobhub.local) comes with the knob hardware." />
                        <WrapPanel>
                            <Button Content="Start pairing mode" IsEnabled="False" Margin="0,0,8,0" />
                            <Button Content="Forget Wi-Fi" IsEnabled="False" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Knob Hub" Style="{StaticResource SectionTitle}" Margin="0,22,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />
                        <TextBlock Text="{Binding HubVersion, StringFormat=You have {0}}" Margin="0,10,0,0" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Firmware" Style="{StaticResource SectionTitle}" Margin="0,22,0,8" />
                <Border Style="{StaticResource Card}">
                    <TextBlock Text="{Binding FirmwareText}" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </Grid>
</Window>
