<Project Sdk="Microsoft.NET.Sdk">
  <!-- Knob Hub's built-in icons, drawn as the knob gets them (see Program.cs). Used by timer_shots.py. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\hub\KnobHub\KnobHub.csproj" />
  </ItemGroup>
</Project>
