<Project Sdk="WixToolset.Sdk/5.0.2">

  <!-- Builds KnobHub-<version>-x64.msi. Use build-installer.ps1, which publishes Knob Hub into payload\ first and
       passes the version through. -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <PayloadDir Condition="'$(PayloadDir)' == ''">$(MSBuildThisFileDirectory)payload</PayloadDir>
    <OutputName>KnobHub-$(Version)-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>Version=$(Version);PayloadDir=$(PayloadDir);AssetsDir=$(MSBuildThisFileDirectory)..\hub\KnobHub\Assets</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- The standard installer screens (progress, finish, cancel, errors) the welcome screen leads to. -->
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
